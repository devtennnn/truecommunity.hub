-- 4. COIN & WALLET FUNCTIONS
create or replace function public._today()
returns date language sql stable as $$
  select (now() at time zone 'Asia/Phnom_Penh')::date
$$;

create or replace function public._wallet_state(p_uid text)
returns jsonb language plpgsql security definer set search_path = public as $$
declare
  v_coins integer;
  v_tasks jsonb;
  v_day date := public._today();
begin
  select coins into v_coins from public.wallets where user_id = p_uid;
  select coalesce(jsonb_agg(jsonb_build_object(
           'task', task,
           'completed', completed_at is not null,
           'claimed', claimed_at is not null)), '[]'::jsonb)
    into v_tasks
    from public.daily_tasks
   where user_id = p_uid and day = v_day;
  return jsonb_build_object('coins', coalesce(v_coins, 0), 'day', v_day, 'tasks', v_tasks);
end $$;

create or replace function public.get_wallet()
returns jsonb language plpgsql security definer set search_path = public as $$
declare uid text := auth.uid()::text;
begin
  if uid is null then raise exception 'login required'; end if;
  insert into public.wallets (user_id) values (uid) on conflict do nothing;
  return public._wallet_state(uid);
end $$;

create or replace function public.complete_task(p_task text)
returns jsonb language plpgsql security definer set search_path = public as $$
declare uid text := auth.uid()::text;
begin
  if uid is null then raise exception 'login required'; end if;
  if p_task not in ('login', 'share', 'chat') then raise exception 'unknown task'; end if;
  insert into public.wallets (user_id) values (uid) on conflict do nothing;
  insert into public.daily_tasks (user_id, day, task, completed_at)
  values (uid, public._today(), p_task, now())
  on conflict (user_id, day, task)
  do update set completed_at = coalesce(public.daily_tasks.completed_at, excluded.completed_at);
  return public._wallet_state(uid);
end $$;

create or replace function public.claim_reward(p_task text)
returns jsonb language plpgsql security definer set search_path = public as $$
declare
  uid text := auth.uid()::text;
  v_day date := public._today();
  v_reward integer;
  v_rows integer;
begin
  if uid is null then raise exception 'login required'; end if;
  v_reward := case p_task
    when 'daily' then 50
    when 'login' then 10
    when 'share' then 30
    when 'chat'  then 10
    else null end;
  if v_reward is null then raise exception 'unknown task'; end if;

  insert into public.wallets (user_id) values (uid) on conflict do nothing;

  if p_task = 'daily' then
    insert into public.daily_tasks (user_id, day, task, completed_at, claimed_at)
    values (uid, v_day, 'daily', now(), now())
    on conflict (user_id, day, task) do nothing;
  else
    update public.daily_tasks
       set claimed_at = now()
     where user_id = uid and day = v_day and task = p_task
       and completed_at is not null and claimed_at is null;
  end if;
  get diagnostics v_rows = row_count;
  if v_rows = 0 then raise exception 'already claimed or task not done'; end if;

  update public.wallets set coins = coins + v_reward, updated_at = now() where user_id = uid;
  insert into public.coin_log (user_id, delta, reason) values (uid, v_reward, 'claim:' || p_task);
  return public._wallet_state(uid);
end $$;

create or replace function public.flip_coin(p_bet integer, p_side text)
returns jsonb language plpgsql security definer set search_path = public as $$
declare
  uid text := auth.uid()::text;
  v_coins integer;
  v_result text;
  v_win boolean;
  v_net integer;
begin
  if uid is null then raise exception 'login required'; end if;
  if p_bet not in (10, 20, 50, 100) then raise exception 'invalid bet'; end if;
  if p_side not in ('heads', 'tails') then raise exception 'invalid side'; end if;

  insert into public.wallets (user_id) values (uid) on conflict do nothing;
  select coins into v_coins from public.wallets where user_id = uid for update;
  if v_coins < p_bet then raise exception 'not enough coins'; end if;

  v_result := case when random() < 0.5 then 'heads' else 'tails' end;
  v_win := (v_result = p_side);
  v_net := case when v_win then floor(p_bet * 0.9)::integer else -p_bet end;

  update public.wallets set coins = coins + v_net, updated_at = now()
   where user_id = uid returning coins into v_coins;
  insert into public.coin_log (user_id, delta, reason) values (uid, v_net, 'flip');

  return jsonb_build_object('result', v_result, 'win', v_win, 'net', v_net, 'coins', v_coins);
end $$;

create or replace function public.spin_slot(p_bet integer)
returns jsonb language plpgsql security definer set search_path = public as $$
declare
  uid text := auth.uid()::text;
  v_coins integer;
  v_r integer[] := array[0, 0, 0];
  v_roll double precision;
  v_mult integer := 0;
  v_kind text := 'none';
  v_net integer;
  i integer;
begin
  if uid is null then raise exception 'login required'; end if;
  if p_bet not in (10, 20, 50, 100) then raise exception 'invalid bet'; end if;

  insert into public.wallets (user_id) values (uid) on conflict do nothing;
  select coins into v_coins from public.wallets where user_id = uid for update;
  if v_coins < p_bet then raise exception 'not enough coins'; end if;

  for i in 1..3 loop
    v_roll := random() * 100;
    v_r[i] := case
      when v_roll < 30 then 0
      when v_roll < 55 then 1
      when v_roll < 75 then 2
      when v_roll < 90 then 3
      else 4 end;
  end loop;

  if v_r[1] = v_r[2] and v_r[2] = v_r[3] then
    v_kind := 'triple';
    v_mult := case v_r[1] when 0 then 4 when 1 then 6 when 2 then 10 when 3 then 20 else 50 end;
  elsif v_r[1] = v_r[2] or v_r[2] = v_r[3] or v_r[1] = v_r[3] then
    v_kind := 'pair';
    v_mult := 1;
  end if;

  v_net := p_bet * v_mult - p_bet;

  update public.wallets set coins = coins + v_net, updated_at = now()
   where user_id = uid returning coins into v_coins;
  insert into public.coin_log (user_id, delta, reason) values (uid, v_net, 'slots:' || v_kind);

  return jsonb_build_object('reels', to_jsonb(v_r), 'kind', v_kind, 'net', v_net, 'coins', v_coins);
end $$;

create or replace function public.top_coins(p_limit integer default 8)
returns table (username text, avatar_url text, role_idx integer, coins integer)
language sql stable security definer set search_path = public as $$
  select p.username::text, p.avatar_url::text, coalesce(p.role_idx, 0)::integer, w.coins
    from public.wallets w
    join public.profiles p on p.id::text = w.user_id
   where w.coins > 0
   order by w.coins desc
   limit least(greatest(p_limit, 1), 20)
$$;

create or replace function public.like_post(p_post_id text)
returns integer language plpgsql security definer set search_path = public as $$
declare
  v_likes integer;
begin
  if auth.uid() is null then raise exception 'login required'; end if;
  update public.posts
     set likes = coalesce(likes, 0) + 1
   where id = p_post_id::bigint
   returning likes into v_likes;
  return coalesce(v_likes, 0);
end $$;

-- 5. ADMIN DASHBOARD FUNCTIONS
create or replace function public.is_current_user_admin()
returns boolean language sql stable security definer set search_path = public as $$
  select coalesce(
    (select is_admin from public.profiles where id::text = auth.uid()::text),
    false
  );
$$;

create or replace function public.admin_save_config(p_configs jsonb)
returns void language plpgsql security definer set search_path = public as $$
declare
  item jsonb;
begin
  if not public.is_current_user_admin() then
    raise exception 'Access denied: Admin privileges required';
  end if;
  for item in select * from jsonb_array_elements(p_configs) loop
    insert into public.site_config (key, value, updated_at)
    values (item->>'key', item->>'value', now())
    on conflict (key) do update
      set value = excluded.value, updated_at = now();
  end loop;
end $$;

create or replace function public.admin_list_users()
returns table (
  id text,
  username text,
  avatar_url text,
  role_idx integer,
  coins integer,
  is_admin boolean,
  is_banned boolean,
  updated_at timestamptz
) language plpgsql stable security definer set search_path = public as $$
begin
  if not public.is_current_user_admin() then
    raise exception 'Access denied: Admin privileges required';
  end if;
  return query
  select
    p.id::text,
    p.username::text,
    p.avatar_url::text,
    coalesce(p.role_idx, 0)::integer,
    coalesce(w.coins, 0)::integer as coins,
    coalesce(p.is_admin, false) as is_admin,
    coalesce(p.is_banned, false) as is_banned,
    p.updated_at
  from public.profiles p
  left join public.wallets w on w.user_id = p.id::text
  order by coalesce(w.coins, 0) desc, p.updated_at desc;
end $$;

create or replace function public.admin_set_user_coins(p_user_id text, p_new_coins integer, p_reason text default 'admin_adjust')
returns integer language plpgsql security definer set search_path = public as $$
declare
  v_old_coins integer := 0;
  v_delta integer;
begin
  if not public.is_current_user_admin() then
    raise exception 'Access denied: Admin privileges required';
  end if;
  if p_new_coins < 0 then
    raise exception 'Coins cannot be negative';
  end if;

  insert into public.wallets (user_id, coins)
  values (p_user_id, 0)
  on conflict (user_id) do nothing;

  select coins into v_old_coins from public.wallets where user_id = p_user_id for update;
  v_delta := p_new_coins - coalesce(v_old_coins, 0);

  update public.wallets set coins = p_new_coins, updated_at = now() where user_id = p_user_id;
  insert into public.coin_log (user_id, delta, reason) values (p_user_id, v_delta, 'admin:' || coalesce(p_reason, 'adjust'));

  return p_new_coins;
end $$;

create or replace function public.admin_update_user(
  p_user_id text,
  p_username text,
  p_role_idx integer,
  p_is_admin boolean,
  p_is_banned boolean
)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not public.is_current_user_admin() then
    raise exception 'Access denied: Admin privileges required';
  end if;
  update public.profiles
     set username = coalesce(nullif(trim(p_username), ''), username),
         role_idx = coalesce(p_role_idx, role_idx),
         is_admin = coalesce(p_is_admin, is_admin),
         is_banned = coalesce(p_is_banned, is_banned),
         updated_at = now()
   where id::text = p_user_id;
end $$;

create or replace function public.admin_delete_post(p_post_id bigint)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not public.is_current_user_admin() then
    raise exception 'Access denied: Admin privileges required';
  end if;
  delete from public.posts where id = p_post_id;
end $$;

create or replace function public.admin_recent_coin_logs(p_limit integer default 40)
returns table (
  id bigint,
  user_id text,
  username text,
  delta integer,
  reason text,
  created_at timestamptz
) language plpgsql stable security definer set search_path = public as $$
begin
  if not public.is_current_user_admin() then
    raise exception 'Access denied: Admin privileges required';
  end if;
  return query
  select
    l.id,
    l.user_id,
    coalesce(p.username, l.user_id)::text as username,
    l.delta,
    l.reason,
    l.created_at
  from public.coin_log l
  left join public.profiles p on p.id::text = l.user_id
  order by l.created_at desc
  limit least(greatest(p_limit, 1), 100);
end $$;

